# LocalSnow local development environment.
# Do not commit real secrets.

# Required when database-backed slices begin.
DATABASE_URL=postgresql://localsnow:localsnow@localhost:5432/localsnow

# Required before guaranteed booking/payment slices begin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required before email/action-link slices begin.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Public application origin for action links and callback URLs.
PUBLIC_APP_URL=http://localhost:5173
